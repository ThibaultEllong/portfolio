---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryCard from '../components/GalleryCard.astro';
import { SITE, url } from '../site';

const galleries = (await getCollection('galleries')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const featured = galleries.filter((g) => g.data.featured);
const shown = featured.length > 0 ? featured : galleries;
const hero = shown[0]?.data.photos[0];
---

<BaseLayout image={hero?.src}>
  <section class="hero">
    {hero && (
      <Image
        class="hero-image"
        src={hero.src}
        alt={hero.alt}
        widths={[800, 1600, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
    )}
    <div class="container hero-text">
      <p class="eyebrow">{SITE.tagline}</p>
      <h1>{SITE.name}</h1>
    </div>
  </section>

  <section class="container work">
    <div class="heading">
      <h2>Selected work</h2>
      <a class="eyebrow" href={url('/work/')}>
        All galleries →
      </a>
    </div>
    <div class="cards">
      {shown.map((gallery) => (
        <GalleryCard gallery={gallery} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    height: 100dvh;
    overflow: hidden;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: hero-in var(--duration-slow) var(--ease-out) both;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(11 11 12 / 0.85), transparent 55%);
  }

  .hero-text {
    position: relative;
    z-index: 1;
    padding-bottom: var(--space-6);
    animation: text-in var(--duration-slow) var(--ease-out) 200ms both;
  }

  h1 {
    font-size: var(--text-display);
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
  }

  @keyframes text-in {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }

  .work {
    padding-top: var(--space-7);
  }

  .heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  h2 {
    font-size: var(--text-xl);
  }

  .heading a:hover {
    color: var(--color-text);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
    gap: var(--space-5) var(--space-4);
  }
</style>
