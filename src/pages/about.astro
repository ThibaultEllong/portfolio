---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site';
---

<BaseLayout title="About" description={`About ${SITE.name}.`}>
  <section class="container page">
    <p class="eyebrow">About</p>
    <h1>{SITE.name}</h1>
    <div class="bio">
      <p>A short bio goes here: who you are, what you photograph, and where you're based.</p>
      <p>
        For commissions and prints, write to <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page {
    padding-top: var(--space-7);
  }

  h1 {
    font-size: var(--text-display);
    margin-bottom: var(--space-5);
  }

  .bio {
    display: grid;
    gap: var(--space-3);
    max-width: 60ch;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .bio a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
