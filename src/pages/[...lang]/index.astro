---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoRing from '../../components/PhotoRing.astro';
import { NAV, SITE } from '../../site';
import { langPaths, link, t, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
// The site's menu (Work, About) frames the name here instead of sitting in the header.
const [left, right] = NAV;
---

<BaseLayout lang={lang}>
  <PhotoRing lang={lang} next="about">
    {/* Shown above the ring: edit freely. */}
    <nav class="title-row" aria-label={t(lang).mainMenu}>
      <a class="side left" href={link(lang, left.href)}>{t(lang)[left.key]}</a>
      <h1 class="name">{SITE.name}</h1>
      <a class="side right" href={link(lang, right.href)}>{t(lang)[right.key]}</a>
    </nav>
    <p class="info">{t(lang).tagline}</p>
  </PhotoRing>

  {/* Below the ring: reached by scrolling past it, or with the arrow on the ring's screen. */}
  <section id="about" class="about container" aria-labelledby="about-title">
    <div class="background">
      <h2 id="about-title" class="eyebrow">{t(lang).about}</h2>
      {/* Placeholder: replace with your own background, in each language. */}
      {
        lang === 'fr' ? (
          <>
            <p class="lead">
              Quelques lignes sur vous : où vous avez grandi, comment vous êtes venu à la
              photographie, ce que vous aimez photographier et où vous vivez aujourd'hui.
            </p>
            <p>
              Un second paragraphe pour tout ce qui mérite d'être dit : les appareils et les
              pellicules que vous utilisez, les lieux où vous revenez, vos expositions ou
              publications.
            </p>
          </>
        ) : (
          <>
            <p class="lead">
              A few lines about you: where you grew up, how you came to photography, what you
              like to photograph and where you're based now.
            </p>
            <p>
              A second paragraph for anything else worth knowing: the cameras and film you use,
              places you return to, exhibitions or publications.
            </p>
          </>
        )
      }
    </div>
    <div class="contact">
      <h2 class="eyebrow">{t(lang).contact}</h2>
      <p>{t(lang).contactLead}</p>
      <ul>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        {
          SITE.social.map((link) => (
            <li>
              <a href={link.href} rel="me noopener" target="_blank">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .name {
    font-size: var(--home-name-size);
  }

  /* Work · name · About on one line; on phones the two links drop just below the name. */
  /* Equal side columns keep the name centered whatever the links' widths. */
  .title-row {
    display: grid;
    grid-template-areas: 'left name right';
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: clamp(3rem, 9vw, 10rem);
  }

  .title-row .name {
    grid-area: name;
  }

  .left {
    grid-area: left;
    justify-self: end;
  }

  .right {
    grid-area: right;
    justify-self: start;
  }

  @media (max-width: 559px) {
    .title-row {
      grid-template-areas:
        'name name'
        'left right';
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-5);
      row-gap: var(--space-2);
    }

    .title-row .name {
      white-space: nowrap;
    }

    .left {
      justify-self: start;
    }

    .right {
      justify-self: end;
    }
  }

  .side {
    padding: var(--space-2);
    font-size: var(--text-base);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    /* The intro lets clicks through to the photos; the links take them. */
    pointer-events: auto;
    transition: color var(--duration-fast) ease;
  }

  .side:hover,
  .side:focus-visible {
    color: var(--color-text);
  }

  .info {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* A full screen of its own, so the page's scroll snapping can stop on it. */
  .about {
    display: grid;
    align-content: center;
    gap: var(--space-6) var(--space-7);
    min-height: 100dvh;
    padding-block: var(--space-7) var(--space-6);
    scroll-snap-align: start;
  }

  @media (min-width: 768px) {
    .about {
      grid-template-columns: 3fr 2fr;
      align-items: start;
    }
  }

  .about h2 {
    margin-bottom: var(--space-4);
    font-family: inherit;
  }

  .background {
    display: grid;
    gap: var(--space-3);
    max-width: 60ch;
    color: var(--color-text-muted);
  }

  .background h2 {
    margin-bottom: var(--space-1);
  }

  .lead {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.3;
    color: var(--color-text);
  }

  .contact p {
    color: var(--color-text-muted);
  }

  .contact ul {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: 0;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .contact a {
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--duration-fast) ease;
  }

  .contact a:hover {
    text-decoration-color: currentColor;
  }
</style>
