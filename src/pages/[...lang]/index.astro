---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoRing from '../../components/PhotoRing.astro';
import { NAV, SITE } from '../../site';
import { langPaths, link, t, type Lang } from '../../i18n';
import portrait from '../../assets/portrait.jpg';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
// The site's menu frames the name here instead of sitting in the header: About on the left,
// Work on the right.
const [right, left] = NAV;
---

<BaseLayout lang={lang}>
  <PhotoRing lang={lang} next="about">
    {/* Shown above the ring: edit freely. */}
    <nav class="title-row" aria-label={t(lang).mainMenu}>
      <a class="side left" href={link(lang, left.href)}>{t(lang)[left.key]}</a>
      <h1 class="name">{SITE.name}</h1>
      <a class="side right" href={link(lang, right.href)}>{t(lang)[right.key]}</a>
    </nav>
    <p class="info">{t(lang).tagline}</p>
  </PhotoRing>

  {/* Below the ring: reached by scrolling past it, or with the arrow on the ring's screen. */}
  <section id="about" class="about" aria-labelledby="about-title">
    {/* The red ribbon behind the text; the screen above and below keeps the page color. */}
    <div class="ribbon on-feature">
      <div class="container about-inner">
        <Image
          class="portrait"
          src={portrait}
          alt={t(lang).portraitAlt}
          widths={[480, 800, 1200]}
          sizes="(min-width: 768px) 30rem, 22rem"
        />
        <div class="background">
          <h2 id="about-title" class="eyebrow">{t(lang).about}</h2>
          {/* Placeholder: replace with your own background, in each language. */}
          {
            lang === 'fr' ? (
              <>
                <p class="lead">
                  Photographe basé à Lille, je travaille à l'argentique comme au numérique. Mon regard se porte tout aussi bien sur les scènes de nature et l'architecture que sur les événements sociétaux et les portraits.
                </p>
                <p>
                  Mes appareils de prédilection sont l'Olympus OM-1 et le Contax TVS pour l'argentique, et le Sony a6700 pour la vidéo et photo numérique.
                </p>
              </>
            ) : (
              <>
                <p class="lead">
                  Photographer based in Lille, I work in both film and digital photography. My work explores nature and architecture as well as social issues and portraiture.
                </p>
                <p>
                  My preferred cameras are the Olympus OM-1 and Contax TVS for film, and the Sony a6700 for digital photography and video.
                </p>
              </>
            )
          }
        </div>
        <div class="contact">
          <h2 class="eyebrow">{t(lang).contact}</h2>
          <p>{t(lang).contactLead}</p>
          <ul>
            <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            {
              SITE.social.map((link) => (
                <li>
                  <a href={link.href} rel="me noopener" target="_blank">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .name {
    font-size: var(--home-name-size);
  }

  /* Work · name · About on one line; on phones the two links drop just below the name. */
  /* Equal side columns keep the name centered whatever the links' widths. */
  .title-row {
    display: grid;
    grid-template-areas: 'left name right';
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: clamp(3rem, 9vw, 10rem);
  }

  .title-row .name {
    grid-area: name;
  }

  .left {
    grid-area: left;
    justify-self: end;
  }

  .right {
    grid-area: right;
    justify-self: start;
  }

  @media (max-width: 559px) {
    .title-row {
      grid-template-areas:
        'name name'
        'left right';
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-5);
      row-gap: var(--space-2);
    }

    .title-row .name {
      white-space: nowrap;
    }

    .left {
      justify-self: start;
    }

    .right {
      justify-self: end;
    }
  }

  .side {
    padding: var(--space-2);
    font-size: var(--text-base);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    /* The intro lets clicks through to the photos; the links take them. */
    pointer-events: auto;
    transition: color var(--duration-fast) ease;
  }

  .side:hover,
  .side:focus-visible {
    color: var(--color-text);
  }

  .info {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  /* A full screen of its own, so the page's scroll snapping can stop on it. */
  .about {
    display: grid;
    align-content: center;
    min-height: 100dvh;
    padding-block: var(--space-7) var(--space-6);
    scroll-snap-align: start;
  }

  /* The full width of the screen, as tall as the text; the text keeps the site's column. The
     portrait reaches past it, above and below. */
  .ribbon {
    --overhang: var(--space-6);
    margin-block: var(--overhang);
    padding-block: var(--space-6);
  }

  /* Phones: the portrait, then the text and the contact details. Wider screens: the portrait on
     the left, the text and contact details beside it. */
  .about-inner {
    display: grid;
    grid-template-areas: 'portrait' 'background' 'contact';
    gap: var(--space-5) var(--space-7);
  }

  @media (min-width: 768px) {
    .about-inner {
      grid-template-areas:
        'portrait background'
        'portrait contact';
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      grid-template-rows: auto 1fr;
      align-items: start;
    }
  }

  /* The photo at its own upright shape. On phones it rises out of the ribbon's top. */
  .portrait {
    grid-area: portrait;
    width: min(100%, 22rem);
    height: auto;
    max-height: 64dvh;
    margin-top: calc(-1 * (var(--space-6) + var(--overhang)));
    object-fit: cover;
    box-shadow: 0 1.5rem 3rem -1rem var(--color-shadow);
  }

  /* On wider screens the ribbon is slimmer, and the portrait reaches out of both its edges (as
     long as the text is shorter than the portrait; longer text makes the ribbon taller). */
  @media (min-width: 768px) {
    .ribbon {
      padding-block: var(--space-5);
    }

    .portrait {
      align-self: center;
      width: min(100%, 30rem);
      max-height: none;
      margin-block: calc(-1 * (var(--space-5) + var(--overhang)));
    }
  }

  .background {
    grid-area: background;
  }

  .contact {
    grid-area: contact;
  }

  .about h2 {
    margin-bottom: var(--space-4);
    font-family: inherit;
  }

  .background {
    display: grid;
    gap: var(--space-3);
    max-width: 60ch;
    color: var(--color-text-muted);
  }

  /* Beside the portrait: a wider column keeps the text shorter than the portrait. */
  @media (min-width: 768px) {
    .background {
      max-width: 44rem;
    }
  }

  .background h2 {
    margin-bottom: var(--space-1);
  }

  .lead {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.3;
    color: var(--color-text);
  }

  .contact p {
    color: var(--color-text-muted);
  }

  .contact ul {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: 0;
    list-style: none;
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  .contact a {
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--duration-fast) ease;
  }

  .contact a:hover {
    text-decoration-color: currentColor;
  }
</style>
