---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site';
import { langPaths, t, type Lang } from '../../i18n';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
// Instagram, shown as its handle (the end of the link in src/site.ts): "@thibault_ellong".
const instagram = SITE.social.find((link) => link.label === 'Instagram');
const handle = instagram && `@${instagram.href.split('/').filter(Boolean).pop()}`;
---

<BaseLayout lang={lang} title={t(lang).about} description={`${t(lang).about} — ${SITE.name}.`}>
  <section class="container page">
    <p class="eyebrow">{t(lang).about}</p>
    <h1>{SITE.name}</h1>
    {/* Placeholder: replace with your own bio, in each language. */}
    {
      lang === 'fr' ? (
        <div class="bio">
          <p>Basé à Lille, je me spécialise dans la photographie de paysages, et je développe mes compétences pour la photo de portraits et le photo-journalisme.
            Riche d'une expérience dans la vidéo et la 3D, j'explore plusieurs médiums avec le but de développer mon style propre: cinématique et contemplatif.
          </p>
          <p>
            Pour une commande ou un tirage, écrivez à <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            {instagram && (
              <>
                {' '}ou contactez-moi sur Instagram :{' '}
                <a href={instagram.href} rel="me noopener" target="_blank">{handle}</a>
              </>
            )}.
          </p>
        </div>
      ) : (
        <div class="bio">
          <p>Based in Lille, I specialize in landscape photography and am developing my skills in portrait and photojournalism.
            With experience in video and 3D, I explore multiple mediums with the goal of developing my own style: cinematic and contemplative.
          </p>
          <p>
            For commissions and prints, write to <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            {instagram && (
              <>
                {' '}or message me on Instagram:{' '}
                <a href={instagram.href} rel="me noopener" target="_blank">{handle}</a>
              </>
            )}.
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>

<style>
  .page {
    padding-top: var(--space-7);
  }

  h1 {
    font-size: var(--text-display);
    margin-bottom: var(--space-5);
  }

  .bio {
    display: grid;
    gap: var(--space-3);
    max-width: 60ch;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .bio a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
