---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GalleryCard from '../../../components/GalleryCard.astro';
import { galleriesByMedium } from '../../../lib/galleries';
import { langPaths, link, pick, t, type Lang } from '../../../i18n';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };

// Film first, then digital (from each folder name's ending), newest first within each.
const groups = await galleriesByMedium();
---

<BaseLayout lang={lang} title={t(lang).work} description={t(lang).workDescription}>
  <div class="container page">
    {/* Every gallery by name, grouped by medium: a column on the left on wide screens, rows
        above on phones. "All" shows every gallery on one page. */}
    <nav class="menu" aria-label={t(lang).galleries}>
      <a class="all" href={link(lang, '/work/all/')}>{t(lang).all}</a>
      {
        groups.map((group) => (
          <div class="group">
            <p class="eyebrow">{t(lang).media[group.medium]}</p>
            <ul>
              {group.galleries.map((gallery) => (
                <li>
                  <a href={link(lang, `/work/${gallery.id}/`)}>{pick(lang, gallery.data.title)}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
    <section class="content">
      <h1>{t(lang).work}</h1>
      {
        groups.map((group) => (
          <section class="medium" aria-label={t(lang).media[group.medium]}>
            <h2 class="eyebrow">{t(lang).media[group.medium]}</h2>
            <div class="cards">
              {group.galleries.map((gallery) => (
                <GalleryCard lang={lang} gallery={gallery} />
              ))}
            </div>
          </section>
        ))
      }
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-7);
  }

  @media (min-width: 900px) {
    .page {
      grid-template-columns: 13rem 1fr;
      gap: var(--space-6);
      align-items: start;
    }

    /* Stays in view while the cards scroll. */
    .menu {
      position: sticky;
      top: var(--space-7);
    }

    .menu ul {
      flex-direction: column;
    }
  }

  .menu {
    display: grid;
    gap: var(--space-5);
  }

  .menu ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin-top: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .menu a {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    transition: color var(--duration-fast) ease;
  }

  .menu a:hover,
  .menu a:focus-visible {
    color: var(--color-text);
  }

  h1 {
    font-size: var(--text-display);
    margin-bottom: var(--space-6);
  }

  .medium + .medium {
    margin-top: var(--space-7);
  }

  .medium h2 {
    margin-bottom: var(--space-4);
    font-family: inherit;
  }

  .cards {
    display: grid;
    /* About 15rem wide each; on phones, two side by side. */
    grid-template-columns: repeat(auto-fill, minmax(min(40%, 15rem), 1fr));
    gap: var(--space-4) var(--space-3);
  }
</style>
