---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PhotoGrid from '../../../components/PhotoGrid.astro';
import ChainViewer from '../../../components/ChainViewer.astro';
import { galleriesByMedium } from '../../../lib/galleries';
import { langPaths, link, pick, t, type Lang } from '../../../i18n';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };

// Every gallery, one after the other, in the Work page's order (film, then digital, newest
// first), each under its own name. One chain viewer runs through all the photos on the page,
// so each grid is told where its photos start in that sequence.
const groups = await galleriesByMedium();
const sections = groups.flatMap((group) =>
  group.galleries.map((gallery) => ({ gallery, medium: t(lang).media[group.medium] })),
);
let start = 0;
const placed = sections.map((section) => {
  const first = start;
  start += section.gallery.data.photos.length;
  return { ...section, start: first };
});
---

<BaseLayout lang={lang} title={t(lang).all} description={t(lang).allDescription}>
  <article class="all">
    <header class="intro">
      <p class="eyebrow">{t(lang).galleriesCount(placed.length, start)}</p>
      <h1>{t(lang).all}</h1>
    </header>

    {
      placed.map(({ gallery, medium, start }) => (
        <section class="gallery" aria-labelledby={`title-${gallery.id}`}>
          <header class="name">
            <h2 id={`title-${gallery.id}`}>
              <a href={link(lang, `/work/${gallery.id}/`)}>{pick(lang, gallery.data.title)}</a>
            </h2>
            <p class="eyebrow">
              {gallery.data.date.getFullYear()} · {medium}
            </p>
          </header>
          <PhotoGrid lang={lang} photos={gallery.data.photos} start={start} />
        </section>
      ))
    }
  </article>

  <ChainViewer lang={lang} />
</BaseLayout>

<style>
  /* Same thin side margins as a gallery page. */
  .all {
    --edge: var(--space-2);
    padding: var(--space-7) var(--edge) var(--space-7);
  }

  /* Text lined up with the header. */
  .intro,
  .name {
    width: 100%;
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: calc(var(--gutter) - var(--edge));
  }

  .intro {
    margin-bottom: var(--space-6);
  }

  h1 {
    margin-top: var(--space-2);
    font-size: var(--text-display);
  }

  /* Each gallery's name, then its photos; generous space before the next one. */
  .gallery + .gallery {
    margin-top: var(--space-7);
  }

  .name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-4);
    margin-bottom: var(--space-4);
  }

  h2 {
    font-size: var(--text-xl);
  }

  h2 a:hover,
  h2 a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media (max-width: 639px) {
    .all {
      padding-block: var(--space-6) var(--space-5);
    }

    .gallery + .gallery {
      margin-top: var(--space-6);
    }
  }
</style>
