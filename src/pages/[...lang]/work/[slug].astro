---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PhotoGrid from '../../../components/PhotoGrid.astro';
import ChainViewer from '../../../components/ChainViewer.astro';
import { mediumOf } from '../../../lib/galleries';
import { langPaths, pick, t, tagLabel } from '../../../i18n';

// Every gallery, in each language.
export async function getStaticPaths() {
  const galleries = await getCollection('galleries');
  return langPaths().flatMap(({ params, props }) =>
    galleries.map((gallery) => ({
      params: { ...params, slug: gallery.id },
      props: { ...props, gallery },
    })),
  );
}

const { lang, gallery } = Astro.props;
const { date, tags, photos } = gallery.data;
const title = pick(lang, gallery.data.title);
const description = pick(lang, gallery.data.description);
const [cover] = photos;
const { Content } = await render(gallery);
const medium = mediumOf(gallery);
// The medium is already in the line above the title, so the tag is left out there.
const otherTags = tags
  .filter((tag) => tag.toLowerCase() !== medium)
  .map((tag) => tagLabel(lang, tag));
---

<BaseLayout lang={lang} title={title} description={description} image={cover.src}>
  <article class="gallery">
    <header class="intro">
      <p class="eyebrow">
        <time datetime={date.toISOString()}>{date.getFullYear()}</time>
        <span> · {t(lang).media[medium]}</span>
        {otherTags.length > 0 && <span> · {otherTags.join(', ')}</span>}
      </p>
      <h1>{title}</h1>
      <p class="lead">{description}</p>
      <div class="story">
        <Content />
      </div>
    </header>

    {/* The Work page's cover flies into the first photo. */}
    <PhotoGrid lang={lang} photos={photos} cover={`cover-${gallery.id}`} />
  </article>

  <ChainViewer lang={lang} />
</BaseLayout>

<style>
  /* The photos use nearly the whole window width, with only a thin margin at the sides. */
  .gallery {
    --edge: var(--space-2);
    padding: var(--space-7) var(--edge) var(--space-7);
  }

  /* The text keeps the site's usual column, lined up with the header. */
  .intro {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto var(--space-7);
    padding-inline: calc(var(--gutter) - var(--edge));
  }

  /* Text in a comfortable reading width; the title can use the whole column. */
  .lead,
  .story {
    max-width: 42rem;
  }

  h1 {
    margin-block: var(--space-2) var(--space-4);
    font-size: var(--text-display);
  }

  .lead {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.35;
  }

  .story {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
    color: var(--color-text-muted);
  }

  @media (max-width: 639px) {
    .gallery {
      padding-block: var(--space-6) var(--space-5);
    }

    .intro {
      margin-bottom: var(--space-5);
    }
  }
</style>
