---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { link, pick, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  gallery: CollectionEntry<'galleries'>;
}

const { lang, gallery } = Astro.props;
const cover = gallery.data.photos[0];
---

<a class="card reveal" href={link(lang, `/work/${gallery.id}/`)}>
  <div class="frame">
    <Image
      src={cover.src}
      alt={pick(lang, cover.alt)}
      widths={[480, 800, 1200]}
      sizes="(min-width: 900px) 20vw, 50vw"
      transition:name={`cover-${gallery.id}`}
    />
    {/* Written over the cover, in white on a soft shade so it reads on any photo. */}
    <div class="meta">
      <h3>{pick(lang, gallery.data.title)}</h3>
      <time datetime={gallery.data.date.toISOString()}>{gallery.data.date.getFullYear()}</time>
    </div>
  </div>
</a>

<style>
  .card {
    display: block;
  }

  .frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--color-surface);
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .card:hover img {
    transform: scale(1.04);
  }

  /* Centered on the cover; a light shade over the whole photo keeps the white text readable. */
  .meta {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: var(--space-1);
    padding: var(--space-4);
    background: rgb(0 0 0 / 0.18);
    color: #fff;
    text-align: center;
    text-shadow: 0 1px 14px rgb(0 0 0 / 0.35);
    pointer-events: none;
  }

  h3 {
    font-family: var(--font-sans);
    font-size: clamp(1.125rem, 0.8rem + 1vw, 1.75rem);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  time {
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    opacity: 0.85;
  }
</style>
