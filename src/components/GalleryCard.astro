---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { url } from '../site';

interface Props {
  gallery: CollectionEntry<'galleries'>;
}

const { gallery } = Astro.props;
const cover = gallery.data.photos[0];
---

<a class="card reveal" href={url(`/work/${gallery.id}/`)}>
  <div class="frame">
    <Image
      src={cover.src}
      alt={cover.alt}
      widths={[480, 800, 1200]}
      sizes="(min-width: 1000px) 33vw, (min-width: 640px) 50vw, 100vw"
      transition:name={`cover-${gallery.id}`}
    />
  </div>
  <div class="meta">
    <h3>{gallery.data.title}</h3>
    <time datetime={gallery.data.date.toISOString()}>{gallery.data.date.getFullYear()}</time>
  </div>
</a>

<style>
  .card {
    display: block;
  }

  .frame {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--color-surface);
  }

  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .card:hover img {
    transform: scale(1.04);
  }

  .meta {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-3);
  }

  h3 {
    font-size: var(--text-lg);
  }

  time {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
