---
import { Image, getImage } from 'astro:assets';

interface Props {
  photos: { src: ImageMetadata; alt: string }[];
}

const { photos } = Astro.props;

// Each thumbnail links to a large optimized version; a React lightbox can take over these links later.
const items = await Promise.all(
  photos.map(async (photo) => ({
    ...photo,
    full: await getImage({ src: photo.src, width: Math.min(2400, photo.src.width) }),
  })),
);
---

<ul class="grid">
  {items.map((photo) => (
    <li class="reveal">
      <a href={photo.full.src}>
        <Image
          src={photo.src}
          alt={photo.alt}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1000px) 33vw, (min-width: 640px) 50vw, 100vw"
        />
      </a>
    </li>
  ))}
</ul>

<style>
  .grid {
    columns: 1;
    column-gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .grid {
      columns: 2;
    }
  }

  @media (min-width: 1000px) {
    .grid {
      columns: 3;
    }
  }

  li {
    break-inside: avoid;
    margin-bottom: var(--space-4);
  }

  a {
    display: block;
    overflow: hidden;
    background: var(--color-surface);
  }

  img {
    width: 100%;
    transition:
      transform var(--duration-slow) var(--ease-out),
      opacity var(--duration-base) ease;
  }

  a:hover img {
    transform: scale(1.03);
  }
</style>
