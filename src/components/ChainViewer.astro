---
// Chain viewer for photo grids (PhotoGrid). Clicking a grid photo opens it here; works with one
// or several grids on the page, the chain running through all their photos in page order.
---

{/* The script fills the track with copies of the grids' photos. */}
<dialog class="chain" data-chain aria-label="Photos" tabindex="-1">
  <div class="veil"></div>
  <div class="track" data-track></div>
  {/* Behind the middle photo when it's opened full screen. */}
  <div class="blackout" data-blackout></div>
  <p class="counter" data-counter aria-live="polite"></p>
  {/* Back to the grid: the same hand-drawn arrow as the gallery pages' header, in its spot. */}
  <button class="close" type="button" data-close aria-label="Back">
    <svg viewBox="0 0 84 40" aria-hidden="true">
      <path d="M80 20.5c-9-2.2-17.5-.6-26.5.8-8.8 1.3-17.3-1.6-26.1-1.2-6.6.3-12.4.9-19 .4"></path>
      <path d="M22.5 8.5c-3.3 3.8-7.9 7.6-14.4 11.9 5.2 2.6 10.4 6.4 15.3 11.6"></path>
    </svg>
  </button>
</dialog>

<script>
  // Clicking a grid photo enlarges it in the middle of the screen, while every photo flies from
  // the grid into one horizontal chain at that same height, in order. Only the photos just
  // before and after stay visible, at the screen's edges. Clicking a neighbor, the arrow keys,
  // the scroll wheel or a swipe slide the chain along. Clicking the middle photo shows it full
  // screen on black, and another click brings it back. Closing flies every photo back to its
  // place in the grid.
  function setupChain() {
    const dialog = document.querySelector<HTMLDialogElement>('[data-chain]');
    const grids = [...document.querySelectorAll<HTMLElement>('[data-grid]')];
    if (!dialog || !grids.length) return;
    // Every photo on the page, in page order, across all the grids.
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-grid] [data-photo]')];
    const thumbs = links.map((link) => link.querySelector('img')!);
    const aspects = links.map((link) =>
      parseFloat(link.closest('figure')!.style.getPropertyValue('--aspect')),
    );
    const track = dialog.querySelector<HTMLElement>('[data-track]')!;
    const veil = dialog.querySelector<HTMLElement>('.veil')!;
    const counter = dialog.querySelector<HTMLElement>('[data-counter]')!;
    const motion = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ease = getComputedStyle(document.documentElement).getPropertyValue('--ease-out').trim();
    const GAP = 24; // px between photos in the chain
    let copies: HTMLImageElement[] = [];
    let active = -1;
    let closing = false;
    // Full screen: the middle photo, clicked, fills the screen on black. Nothing else responds
    // there (no browsing); another click brings it back into the chain.
    let full = false;

    type Rect = { x: number; y: number; w: number; h: number };

    // Where each photo sits in the chain when photo i is in the middle: all at the height that
    // makes photo i as large as the screen allows, side by side in page order.
    const chainLayout = (i: number): Rect[] => {
      const h = Math.min(innerHeight * 0.8, (innerWidth * 0.72) / aspects[i]);
      const starts: number[] = [];
      let x = 0;
      for (const aspect of aspects) {
        starts.push(x);
        x += aspect * h + GAP;
      }
      const shift = innerWidth / 2 - (aspects[i] * h) / 2 - starts[i];
      return aspects.map((aspect, k) => ({
        x: shift + starts[k],
        y: (innerHeight - h) / 2,
        w: aspect * h,
        h,
      }));
    };

    const shown = (k: number) => Math.abs(k - active) <= 1;
    const at = (r: Rect) => `translate(${r.x}px, ${r.y}px)`;
    // The transform that draws a copy (laid out at chain size r) over the box `from`.
    const over = (from: DOMRect, r: Rect) =>
      `translate(${from.left}px, ${from.top}px) scale(${from.width / r.w}, ${from.height / r.h})`;

    // Puts every copy at its chain position; CSS transitions animate the change when browsing.
    const place = () => {
      const rects = chainLayout(active);
      copies.forEach((copy, k) => {
        const r = rects[k];
        copy.style.width = `${r.w}px`;
        copy.style.height = `${r.h}px`;
        copy.style.transform = at(r);
        copy.style.opacity = shown(k) ? '1' : '0';
        copy.classList.toggle('is-current', k === active);
        // Ask for an image file sharp enough for the size it's shown at.
        copy.sizes = `${Math.ceil(r.w)}px`;
      });
      const pad = (n: number) => String(n).padStart(2, '0');
      counter.textContent = `${pad(active + 1)} / ${pad(copies.length)}`;
      return rects;
    };

    const open = (i: number) => {
      const from = thumbs.map((thumb) => thumb.getBoundingClientRect());
      copies = thumbs.map((thumb, k) => {
        const copy = new Image();
        copy.src = thumb.currentSrc || thumb.src;
        copy.srcset = thumb.srcset;
        copy.alt = thumb.alt;
        copy.dataset.k = String(k);
        return copy;
      });
      track.replaceChildren(...copies);
      active = i;
      dialog.showModal();
      dialog.focus();
      track.classList.add('still');
      const rects = place();
      grids.forEach((grid) => grid.classList.add('is-lifted'));
      if (motion) {
        const timing = { duration: 750, easing: ease };
        copies.forEach((copy, k) => {
          copy.animate(
            [
              { transform: over(from[k], rects[k]), opacity: 1 },
              { transform: at(rects[k]), opacity: shown(k) ? 1 : 0 },
            ],
            timing,
          );
        });
        veil.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 450, easing: 'ease' });
      }
      requestAnimationFrame(() => requestAnimationFrame(() => track.classList.remove('still')));
    };

    const go = (i: number) => {
      if (closing || full || i < 0 || i >= copies.length || i === active) return;
      active = i;
      place();
    };

    // As large as the screen allows, keeping the photo's shape, centered.
    const fullRect = (aspect: number): Rect => {
      const w = Math.min(innerWidth, innerHeight * aspect);
      const h = w / aspect;
      return { x: (innerWidth - w) / 2, y: (innerHeight - h) / 2, w, h };
    };

    const enterFull = () => {
      const copy = copies[active];
      const r = fullRect(aspects[active]);
      full = true;
      dialog.classList.add('is-full');
      copy.style.width = `${r.w}px`;
      copy.style.height = `${r.h}px`;
      copy.style.transform = at(r);
      copy.sizes = `${Math.ceil(r.w)}px`;
    };

    const exitFull = () => {
      full = false;
      dialog.classList.remove('is-full');
      place();
    };

    const close = async () => {
      if (!dialog.open || closing) return;
      closing = true;
      full = false;
      dialog.classList.remove('is-full');
      // Bring the photo being viewed into view in the grid, so it has a place to fly back to.
      links[active].scrollIntoView({ block: 'center', behavior: 'instant' });
      if (motion) {
        const rects = chainLayout(active);
        const to = thumbs.map((thumb) => thumb.getBoundingClientRect());
        const timing = { duration: 600, easing: ease, fill: 'forwards' } as const;
        veil.animate([{ opacity: 0 }], timing);
        const flights = copies.map(
          (copy, k) =>
            copy.animate([{ transform: over(to[k], rects[k]), opacity: 1 }], timing).finished,
        );
        await Promise.all(flights);
      }
      grids.forEach((grid) => grid.classList.remove('is-lifted'));
      dialog.close();
      veil.getAnimations().forEach((a) => a.cancel());
      track.replaceChildren();
      copies = [];
      closing = false;
    };

    grids.forEach((grid) =>
      grid.addEventListener('click', (event) => {
        const link = (event.target as Element).closest<HTMLAnchorElement>('[data-photo]');
        if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
        event.preventDefault();
        open(links.indexOf(link));
      }),
    );

    let swiped = false;
    dialog.addEventListener('click', (event) => {
      if (swiped) {
        swiped = false;
        return;
      }
      // Full screen: any click goes back to the chain.
      if (full) {
        exitFull();
        return;
      }
      const copy = (event.target as Element).closest<HTMLImageElement>('.track img');
      const k = copy ? Number(copy.dataset.k) : -1;
      // The middle photo opens full screen; a neighbor slides the chain to it; the background
      // or Close closes the chain.
      if (k === active) enterFull();
      else if (k >= 0 && shown(k)) go(k);
      else close();
    });
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') go(active - 1);
      if (event.key === 'ArrowRight') go(active + 1);
    });

    // Scroll wheel (or a two-finger swipe on a trackpad): one photo per gesture, down or right
    // for the next one. A trackpad sends a stream of small events, so the movement adds up until
    // it's worth a step, and further events are ignored until the chain has nearly settled.
    const WHEEL_STEP = 40; // px of scrolling that counts as a step
    const WHEEL_PAUSE_MS = 450;
    let wheelSum = 0;
    let wheelLockedUntil = 0;
    dialog.addEventListener(
      'wheel',
      (event) => {
        event.preventDefault();
        if (full || closing) return;
        const now = performance.now();
        if (now < wheelLockedUntil) return;
        const delta =
          Math.abs(event.deltaY) >= Math.abs(event.deltaX) ? event.deltaY : event.deltaX;
        // Line-based wheels report a few lines per notch, not pixels.
        wheelSum += event.deltaMode === 1 ? delta * 40 : delta;
        if (Math.abs(wheelSum) < WHEEL_STEP) return;
        go(active + Math.sign(wheelSum));
        wheelSum = 0;
        wheelLockedUntil = now + WHEEL_PAUSE_MS;
      },
      { passive: false },
    );

    // Escape: out of full screen first, then out of the chain.
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      if (full) exitFull();
      else close();
    });

    // Swipe (touch and pen): left for the next photo, right for the previous one.
    let start: { id: number; x: number; y: number } | undefined;
    dialog.addEventListener('pointerdown', (event) => {
      swiped = false;
      if (event.pointerType !== 'mouse') {
        start = { id: event.pointerId, x: event.clientX, y: event.clientY };
      }
    });
    dialog.addEventListener('pointerup', (event) => {
      if (event.pointerId !== start?.id) return;
      const dx = event.clientX - start.x;
      const dy = event.clientY - start.y;
      start = undefined;
      if (!full && Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
        swiped = true;
        go(active + (dx < 0 ? 1 : -1));
      }
    });

    const onResize = () => {
      if (!dialog.open || closing) return;
      track.classList.add('still');
      place();
      if (full) enterFull();
      requestAnimationFrame(() => track.classList.remove('still'));
    };
    addEventListener('resize', onResize);
    document.addEventListener('astro:before-swap', () => removeEventListener('resize', onResize), {
      once: true,
    });
  }

  document.addEventListener('astro:page-load', setupChain);
</script>

<style>
  /* The page doesn't scroll while the viewer is open. */
  :global(html:has(.chain[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  .chain {
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
    outline: none;
    /* Horizontal drags are swipes; pinch-zoom stays with the browser. */
    touch-action: pan-y pinch-zoom;
  }

  .chain::backdrop {
    background: transparent;
  }

  .veil {
    position: absolute;
    inset: 0;
    background: var(--color-bg);
    cursor: zoom-out;
  }

  .track {
    position: absolute;
    inset: 0;
  }

  /* The copies are created by the script, hence :global. Each is laid out at its chain size and
     moved into place with a transform; changes glide when browsing. */
  .track :global(img) {
    position: absolute;
    top: 0;
    left: 0;
    max-width: none;
    transform-origin: 0 0;
    cursor: pointer;
    transition:
      transform 0.7s var(--ease-out),
      width 0.7s var(--ease-out),
      height 0.7s var(--ease-out),
      opacity 0.4s ease;
  }

  /* Always above the black layer, so it stays in view while the black fades in and out. */
  .track :global(img.is-current) {
    z-index: 2;
    cursor: zoom-in;
  }

  .track.still :global(img) {
    transition: none;
  }

  /* Full screen: black fades in over the chain, the middle photo grows above it, and the
     counter and Close button step aside. A click anywhere goes back. */
  .blackout {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: #000;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.5s ease;
  }

  .chain.is-full .blackout {
    opacity: 1;
    pointer-events: auto;
    cursor: zoom-out;
  }

  .chain.is-full .track :global(img.is-current) {
    cursor: zoom-out;
  }

  .counter,
  .close {
    transition: opacity 0.3s ease;
  }

  .chain.is-full .counter,
  .chain.is-full .close {
    opacity: 0;
    pointer-events: none;
  }

  .counter {
    position: absolute;
    bottom: var(--space-4);
    left: 50%;
    translate: -50% 0;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    color: var(--color-text-muted);
    pointer-events: none;
  }

  /* Placed and drawn like the back arrow in the gallery pages' header. */
  .close {
    position: absolute;
    top: var(--space-4);
    left: var(--gutter);
    display: grid;
    place-items: center;
    margin-left: calc(-1 * var(--space-2));
    padding: var(--space-2);
    border: 0;
    background: none;
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      color var(--duration-fast) ease,
      translate var(--duration-base) var(--ease-out),
      opacity 0.3s ease;
  }

  /* Nudges left on hover, toward where it leads. */
  .close:hover,
  .close:focus-visible {
    color: var(--color-text);
    translate: -0.25rem 0;
  }

  .close svg {
    width: 2.25rem;
    height: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
