---
import { NAV, SITE, url } from '../site';

const current = Astro.url.pathname;
// The home page shows the name large above the ring, so the header leaves it out there.
const isHome = current.replace(/\/$/, '') === url('/').replace(/\/$/, '');
// Inside a gallery (/work/<gallery>/) the header is solid, so photos don't show through it.
const isGallery = new RegExp(`^${url('/work/')}[^/]+/?$`).test(current);
---

<header class:list={['header', { solid: isGallery }]}>
  <div class="container inner">
    {
      isGallery && (
        <a class="back" href={url('/work/')} aria-label="Back to Work">
          {/* The home page's hand-drawn arrow, turned to point left. */}
          <svg viewBox="0 0 84 40" aria-hidden="true">
            <path d="M80 20.5c-9-2.2-17.5-.6-26.5.8-8.8 1.3-17.3-1.6-26.1-1.2-6.6.3-12.4.9-19 .4" />
            <path d="M22.5 8.5c-3.3 3.8-7.9 7.6-14.4 11.9 5.2 2.6 10.4 6.4 15.3 11.6" />
          </svg>
        </a>
      )
    }
    {
      !isHome && (
        <a class="brand" href={url('/')}>
          {SITE.name}
        </a>
      )
    }
    <nav aria-label="Main">
      <ul>
        {NAV.map((item) => {
          const href = url(item.href);
          return (
            <li>
              <a href={href} aria-current={current.startsWith(href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
    <button class="theme" type="button" aria-label="Dark mode" aria-pressed="false" data-theme-toggle>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="8"></circle>
        <path d="M12 4a8 8 0 0 1 0 16Z"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  // Switches between light and dark, starting from whatever is showing (the device's setting
  // until a choice is made), and remembers the choice for later visits.
  const isDark = () => {
    const theme = document.documentElement.dataset.theme;
    return theme ? theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  };
  const syncButton = () => {
    document.querySelector('[data-theme-toggle]')?.setAttribute('aria-pressed', String(isDark()));
  };

  document.addEventListener('click', (event) => {
    if (!(event.target as Element).closest('[data-theme-toggle]')) return;
    const theme = isDark() ? 'light' : 'dark';
    document.documentElement.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {}
    syncButton();
  });
  document.addEventListener('astro:page-load', syncButton);
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    padding-block: var(--space-4);
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-bg) 85%, transparent),
      transparent
    );
  }

  .header.solid {
    background: var(--color-bg);
  }

  .back {
    display: grid;
    place-items: center;
    margin-left: calc(-1 * var(--space-2));
    padding: var(--space-2);
    color: var(--color-text-muted);
    transition:
      color var(--duration-fast) ease,
      translate var(--duration-base) var(--ease-out);
  }

  /* Nudges left on hover, toward where it leads. */
  .back:hover,
  .back:focus-visible {
    color: var(--color-text);
    translate: -0.25rem 0;
  }

  /* On phones, the header can't fit the arrow, the name and the menu on one line: inside a
     gallery the arrow takes the name's place. */
  @media (max-width: 479px) {
    .back + .brand {
      display: none;
    }
  }

  .back svg {
    width: 2.25rem;
    height: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand {
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  ul {
    display: flex;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  nav a {
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: color var(--duration-fast) ease;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-text);
  }

  nav {
    margin-left: auto;
  }

  /* A half-filled circle: light and dark. */
  .theme {
    display: grid;
    place-items: center;
    padding: var(--space-1);
    border: 0;
    background: none;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color var(--duration-fast) ease;
  }

  .theme:hover {
    color: var(--color-text);
  }

  .theme svg {
    width: 1.125rem;
    height: 1.125rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .theme path {
    fill: currentColor;
    stroke: none;
  }
</style>
