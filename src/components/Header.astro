---
import { NAV, SITE } from '../site';
import { LANGS, link, pagePath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const current = Astro.url.pathname;
// The page's path without the base path or language, e.g. "/work/all/".
const path = pagePath(current);
// The home page shows the name large above the ring, so the header leaves it out there.
const isHome = path === '/';
// Inside a gallery (/work/<gallery>/) the header is solid, so photos don't show through it.
const isGallery = /^\/work\/[^/]+\/?$/.test(path);
---

<header class:list={['header', { solid: isGallery, home: isHome }]}>
  <div class="container inner">
    {
      isGallery && (
        <a class="back" href={link(lang, '/work/')} aria-label={t(lang).backToWork}>
          {/* The home page's hand-drawn arrow, turned to point left. */}
          <svg viewBox="0 0 84 40" aria-hidden="true">
            <path d="M80 20.5c-9-2.2-17.5-.6-26.5.8-8.8 1.3-17.3-1.6-26.1-1.2-6.6.3-12.4.9-19 .4" />
            <path d="M22.5 8.5c-3.3 3.8-7.9 7.6-14.4 11.9 5.2 2.6 10.4 6.4 15.3 11.6" />
          </svg>
        </a>
      )
    }
    {
      !isHome && (
        <a class="brand" href={link(lang, '/')}>
          {SITE.name}
        </a>
      )
    }
    {
      // On the home page the menu sits on either side of the name instead.
      !isHome && (
        <nav class="menu" aria-label={t(lang).mainMenu}>
          <ul>
            {NAV.map((item) => {
              const href = link(lang, item.href);
              return (
                <li>
                  <a href={href} aria-current={current.startsWith(href) ? 'page' : undefined}>
                    {t(lang)[item.key]}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      )
    }
    {/* FR / EN: the same page in the other language; the current one is highlighted. */}
    <nav class="langs" aria-label={t(lang).language}>
      {
        LANGS.map((other) => (
          <a
            href={link(other, path)}
            hreflang={other}
            lang={other}
            aria-current={other === lang ? 'true' : undefined}
          >
            {other.toUpperCase()}
          </a>
        ))
      }
    </nav>
    {/* A sliding switch: the knob sits left in light mode and right in dark mode. */}
    <button
      class="theme"
      type="button"
      role="switch"
      aria-label={t(lang).darkMode}
      aria-checked="false"
      data-theme-toggle
    >
      <span class="track"><span class="knob"></span></span>
    </button>
  </div>
</header>

<script>
  // Switches between light and dark, starting from whatever is showing (the device's setting
  // until a choice is made), and remembers the choice for later visits.
  const isDark = () => {
    const theme = document.documentElement.dataset.theme;
    return theme ? theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  };
  const syncButton = () => {
    document.querySelector('[data-theme-toggle]')?.setAttribute('aria-checked', String(isDark()));
  };

  document.addEventListener('click', (event) => {
    if (!(event.target as Element).closest('[data-theme-toggle]')) return;
    const theme = isDark() ? 'light' : 'dark';
    document.documentElement.dataset.theme = theme;
    try {
      localStorage.setItem('theme', theme);
    } catch {}
    syncButton();
  });
  document.addEventListener('astro:page-load', syncButton);

  // Over a red block (.on-feature: the ribbon in the home page's About section), the header
  // takes the block's light text colors.
  const syncTone = () => {
    const header = document.querySelector<HTMLElement>('.header');
    const toggle = header?.querySelector('[data-theme-toggle]');
    if (!header || !toggle) return;
    const box = toggle.getBoundingClientRect();
    const y = (box.top + box.bottom) / 2;
    const over = [...document.querySelectorAll('main .on-feature')].some((el) => {
      const r = el.getBoundingClientRect();
      return r.top <= y && r.bottom >= y;
    });
    header.classList.toggle('on-feature', over);
  };
  addEventListener('scroll', syncTone, { passive: true });
  document.addEventListener('astro:page-load', syncTone);
</script>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    padding-block: var(--space-4);
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--color-bg) 85%, transparent),
      transparent
    );
  }

  .header.solid {
    background: var(--color-bg);
  }

  /* Over a red block: light text (from .on-feature) on no background of its own. */
  .header.on-feature {
    background: none;
  }

  .back {
    display: grid;
    place-items: center;
    margin-left: calc(-1 * var(--space-2));
    padding: var(--space-2);
    color: var(--color-text-muted);
    transition:
      color var(--duration-fast) ease,
      translate var(--duration-base) var(--ease-out);
  }

  /* Nudges left on hover, toward where it leads. */
  .back:hover,
  .back:focus-visible {
    color: var(--color-text);
    translate: -0.25rem 0;
  }

  /* On phones, the header can't fit the arrow, the name and the menu on one line: inside a
     gallery the arrow takes the name's place. */
  @media (max-width: 479px) {
    .back + .brand {
      display: none;
    }
  }

  .back svg {
    width: 2.25rem;
    height: auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Right-aligned, so the theme toggle stays on the right when it's alone (home page); on other
     pages the menu's auto margin keeps the name on the left. */
  .inner {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-4);
  }

  .brand {
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  ul {
    display: flex;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  nav a {
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
    transition: color var(--duration-fast) ease;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--color-text);
  }

  .menu {
    margin-left: auto;
  }

  .langs {
    display: flex;
    gap: var(--space-1);
  }

  .langs a {
    padding: var(--space-1);
  }

  /* The current language stands out; the other one is the link to switch. */
  .langs a[aria-current] {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
  }

  /* On the home page the header holds only the switch: it's lowered to line up with the row of
     Work · name · About (which starts 4.5rem from the top; its middle is half the name's line).
     Nothing scrolls under it there, so it has no background (it would show over the red
     ribbon). */
  .header.home {
    background: none;
    padding-top: calc(4.5rem + 0.55 * var(--home-name-size) - 0.875rem);
    /* That makes the header reach down over the name's row: let clicks through to Work and
       About, except on the switch itself. */
    pointer-events: none;
  }

  .header.home .theme,
  .header.home .langs {
    pointer-events: auto;
  }

  /* On phones the name fills that line, so the switch stays at the top. (Same width as the home
     page's breakpoint, where Work and About move below the name.) */
  @media (max-width: 559px) {
    .header.home {
      padding-top: var(--space-4);
    }
  }

  .theme {
    display: grid;
    place-items: center;
    padding: var(--space-1);
    border: 0;
    background: none;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: color var(--duration-fast) ease;
  }

  .theme:hover,
  .theme:focus-visible {
    color: var(--color-text);
  }

  .track {
    display: block;
    width: 2.25rem;
    height: 1.25rem;
    padding: 2px;
    border: 1px solid currentColor;
    border-radius: 999px;
  }

  .knob {
    display: block;
    width: calc(1.25rem - 6px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: currentColor;
    transition: translate var(--duration-base) var(--ease-out);
  }

  /* Slid to the right in dark mode, whether chosen with the switch or set by the device. The
     position follows the page's theme, so it's right from the first paint. */
  :global(:root[data-theme='dark']) .knob {
    translate: 1rem 0;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .knob {
      translate: 1rem 0;
    }
  }
</style>
